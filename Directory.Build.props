<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA1416: Windows-only APIs must be guarded or marked [SupportedOSPlatform("windows")]. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <Version>0.1.0</Version>
    <Authors>GreyHaven contributors</Authors>
    <Product>GreyHaven</Product>
    <Copyright>Copyright (c) GreyHaven contributors</Copyright>
  </PropertyGroup>
</Project>
