<Project Sdk="WixToolset.Sdk/6.0.2">
  <!-- GreyHaven.msi: per-machine install to Program Files, a Start menu entry and a working uninstall.
       Built on Windows only (WiX needs Windows Installer); see .github/workflows/ci.yml. -->
  <PropertyGroup>
    <OutputName>GreyHaven</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Version=$(Version);AppDir=$(AppDir)</DefineConstants>
    <!-- ICE38/43/57 assume the Start menu folder is per-user. This package is per-machine
         (Scope="perMachine"), where an all-users shortcut with an HKLM key path is the standard
         pattern; CI's install test checks the shortcut really lands in the all-users Start menu. -->
    <SuppressIces>ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>
</Project>
