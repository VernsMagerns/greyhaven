<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">

    <!-- Converters -->
    <infra:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
    <infra:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
    <infra:HasValueToVisibilityConverter x:Key="NoValueToVisibility" Invert="True" />
    <infra:PaletteBrushConverter x:Key="PaletteBrush" />
    <infra:NoticeBrushConverter x:Key="NoticeBrush" />
    <infra:ItemNumberConverter x:Key="ItemNumber" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Text. Headings lead directly: no small all-caps "eyebrow" labels above them. -->
    <Style x:Key="Heading1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="Heading2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
        <Setter Property="Margin" Value="0,28,0,10" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="Heading3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource GH.TextSecondary}" />
    </Style>
    <Style x:Key="Strong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GH.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GH.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="CommandBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GH.CommandBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GH.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- A link that is a real, focusable button (keyboard + screen reader friendly). -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource GH.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,2">
                        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" TextDecorations="Underline"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" FontSize="14" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GH.Text}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rating badge: icon + text + colour, never colour alone. -->
    <DataTemplate x:Key="RatingBadge">
        <StackPanel Orientation="Horizontal">
            <infra:DecorativeText Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"
                       Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
            <TextBlock Text="{Binding RatingLabel}" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
