<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">

    <!-- Converters -->
    <infra:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
    <infra:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
    <infra:NoAccessKeyConverter x:Key="NoAccessKey" />
    <infra:HasValueToVisibilityConverter x:Key="NoValueToVisibility" Invert="True" />
    <infra:PaletteBrushConverter x:Key="PaletteBrush" />
    <infra:NoticeBrushConverter x:Key="NoticeBrush" />
    <infra:ItemNumberConverter x:Key="ItemNumber" />

    <!-- "Market Day" brand fonts, shipped with the app (SIL Open Font License 1.1, see Fonts\*-OFL.txt). -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Fonts/#Rubik, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#Lexend, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Text. Headings lead directly: no small all-caps "eyebrow" labels above them. -->
    <Style x:Key="Heading1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="Heading2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
        <Setter Property="Margin" Value="0,32,0,10" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="Heading3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
    </Style>
    <Style x:Key="Lead" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="27" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource GH.TextSecondary}" />
    </Style>
    <Style x:Key="Strong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BigKey" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
    </Style>

    <!-- Surfaces. "Sticker": thick ink outline and a hard offset shadow. The shadow is a second
         shape (not an Effect), so text keeps ClearType. In High Contrast the shadow is transparent. -->
    <Style x:Key="Sticker" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource GH.Card}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{DynamicResource GH.Shadow}" CornerRadius="12" Margin="5,5,0,0" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GH.CardBorder}"
                                BorderThickness="2.5" CornerRadius="12" Margin="0,0,5,5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Plain card (no shadow), for lists of parts and smaller boxes. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GH.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GH.CardBorder}" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="InfoBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GH.NoticeInfo}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GH.CardBorder}" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,4,0,14" />
    </Style>
    <Style x:Key="WarningBox" TargetType="Border" BasedOn="{StaticResource InfoBox}">
        <Setter Property="Background" Value="{DynamicResource GH.NoticeWarning}" />
    </Style>
    <Style x:Key="DangerBox" TargetType="Border" BasedOn="{StaticResource WarningBox}">
        <Setter Property="BorderThickness" Value="4" />
    </Style>
    <Style x:Key="CommandBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GH.CommandBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GH.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource GH.CardBorder}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource GH.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource GH.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GH.CardBorder}" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Padding" Value="32,12" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- "Go" buttons (the walkthrough's Next): green, so moving on reads as safe. -->
    <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Background" Value="{DynamicResource GH.Go}" />
    </Style>

    <!-- A link that is a real, focusable button (keyboard + screen reader friendly). -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource GH.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,2">
                        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" TextDecorations="Underline"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GH.Text}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        "Show more": an expander whose header is a red text link with an arrow, like the saved
        report's <details>. The header is a DisclosureButton, so screen readers hear
        "collapsed/expanded". In High Contrast, GH.Accent and GH.Text are Windows' own colours.
    -->
    <Style x:Key="ShowMore" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource GH.Text}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <infra:DisclosureButton Content="{TemplateBinding Header}" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}">
                            <infra:DisclosureButton.Template>
                                <ControlTemplate TargetType="infra:DisclosureButton">
                                    <!-- MinHeight 32 keeps the click/tap area comfortable even for one short word. -->
                                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6"
                                            Padding="4,3,8,3" Margin="-6,0,0,0" MinHeight="32">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="Arrow" Data="M 0,0 L 5,5 L 0,10" Stroke="{DynamicResource GH.Accent}" StrokeThickness="2.2"
                                                  Width="7" Height="11" Stretch="None" Margin="2,0,9,0" VerticalAlignment="Center" RenderTransformOrigin="0.4,0.5" />
                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource GH.Accent}" FontWeight="SemiBold" FontSize="15" TextDecorations="Underline"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GH.CommandBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GH.Text}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </infra:DisclosureButton.Template>
                        </infra:DisclosureButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Focusable="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rating badge: icon + text + colour, never colour alone. -->
    <DataTemplate x:Key="RatingBadge">
        <StackPanel Orientation="Horizontal">
            <infra:DecorativeText Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"
                       Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
            <TextBlock Text="{Binding RatingLabel}" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
