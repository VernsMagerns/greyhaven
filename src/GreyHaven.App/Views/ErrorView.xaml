<UserControl x:Class="GreyHaven.App.Views.ErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">
    <StackPanel Margin="0,24,0,0">
        <TextBlock Text="Something went wrong" Style="{StaticResource Heading1}"
                   Focusable="True" infra:Accessibility.FocusOnShow="True" />
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Body}" MaxWidth="680" HorizontalAlignment="Left" />
        <Expander Header="Technical details" Margin="0,16,0,0" MaxWidth="680" HorizontalAlignment="Left">
            <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="{StaticResource CodeFont}" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Error details" />
        </Expander>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="_Try again" Command="{Binding ScanCommand}" Padding="24,6" />
            <Button Content="_Back to start" Command="{Binding StartOverCommand}" Padding="24,6" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
