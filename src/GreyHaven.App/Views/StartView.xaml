<UserControl x:Class="GreyHaven.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">
    <StackPanel Margin="0,16,0,0">
        <Border Style="{StaticResource InfoBox}" CornerRadius="14" Padding="10,2" HorizontalAlignment="Left" BorderThickness="1.5"
                Visibility="{Binding DemoText, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding DemoText}" Style="{StaticResource Body}" FontSize="14" />
        </Border>
        <!-- A newer GreyHaven is out: notify only, the person decides. -->
        <Border Style="{StaticResource InfoBox}" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="Update"
                Visibility="{Binding UpdateText, Converter={StaticResource HasValueToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Body}" VerticalAlignment="Center" infra:Accessibility.Announce="True" />
                <Button Content="Get the new version" Command="{Binding OpenUpdateCommand}" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Will Linux work on your PC?" Style="{StaticResource Heading1}" FontSize="40"
                           Focusable="True" infra:Accessibility.FocusOnShow="True" />
                <TextBlock Text="{Binding IntroText}" Style="{StaticResource Lead}" MaxWidth="520" HorizontalAlignment="Left" />

                <Button Content="_Scan my PC" Command="{Binding ScanCommand}" Margin="0,24,0,8" Style="{StaticResource AccentButton}" FontSize="20"
                        AutomationProperties.HelpText="Reads your PC's parts and checks them against Linux. Usually takes under a minute." />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" infra:Accessibility.Announce="True"
                           Visibility="{Binding StatusText, Converter={StaticResource HasValueToVisibility}}" />

                <CheckBox IsChecked="{Binding UseOnlineLookups}" Margin="0,20,0,0" HorizontalAlignment="Left"
                          AutomationProperties.Name="{Binding OnlineLookupsText}" AutomationProperties.HelpText="{Binding OnlineLookupsDetail}">
                    <StackPanel>
                        <TextBlock Text="{Binding OnlineLookupsText}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding OnlineLookupsDetail}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding CheckForUpdates}" Margin="0,10,0,0" HorizontalAlignment="Left"
                          AutomationProperties.Name="{Binding CheckForUpdatesText}">
                    <TextBlock Text="{Binding CheckForUpdatesText}" Style="{StaticResource Secondary}" />
                </CheckBox>
                <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource Secondary}" FontSize="14" Margin="0,14,0,0" />
            </StackPanel>

            <!-- Decorative: a ticket sticker with a tick, in the Market Day style. Hidden from screen readers. -->
            <Viewbox Grid.Column="1" Width="220" Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                     Visibility="{DynamicResource GH.DecorVisibility}">
                <Canvas Width="260" Height="220">
                    <Rectangle Canvas.Left="38" Canvas.Top="48" Width="150" Height="80" RadiusX="10" RadiusY="10" Fill="{DynamicResource GH.Shadow}" />
                    <Rectangle Canvas.Left="30" Canvas.Top="40" Width="150" Height="80" RadiusX="10" RadiusY="10" Fill="#FFC93C" Stroke="{DynamicResource GH.CardBorder}" StrokeThickness="4" />
                    <Ellipse Canvas.Left="20" Canvas.Top="70" Width="20" Height="20" Fill="{DynamicResource GH.Page}" Stroke="{DynamicResource GH.CardBorder}" StrokeThickness="4" />
                    <Ellipse Canvas.Left="170" Canvas.Top="70" Width="20" Height="20" Fill="{DynamicResource GH.Page}" Stroke="{DynamicResource GH.CardBorder}" StrokeThickness="4" />
                    <Ellipse Canvas.Left="156" Canvas.Top="116" Width="84" Height="84" Fill="{DynamicResource GH.Shadow}" />
                    <Ellipse Canvas.Left="150" Canvas.Top="110" Width="84" Height="84" Fill="{DynamicResource GH.Accent}" Stroke="{DynamicResource GH.CardBorder}" StrokeThickness="4" />
                    <Path Data="M172,152 l14,14 l26,-28" Stroke="{DynamicResource GH.OnAccent}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
        </Grid>
    </StackPanel>
</UserControl>
