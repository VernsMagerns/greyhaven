<UserControl x:Class="GreyHaven.App.Views.WorkingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">
    <StackPanel Margin="0,24,0,0">
        <TextBlock Text="Checking your PC" Style="{StaticResource Heading1}"
                   Focusable="True" infra:Accessibility.FocusOnShow="True" />
        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,8,0,16" MaxWidth="680" HorizontalAlignment="Stretch"
                     AutomationProperties.Name="Checking your PC" />
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" infra:Accessibility.Announce="True" />
        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Secondary}" infra:Accessibility.Announce="True"
                   Visibility="{Binding ProgressText, Converter={StaticResource HasValueToVisibility}}" />
        <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" MaxWidth="680" HorizontalAlignment="Left"
                   Visibility="{Binding ProgressText, Converter={StaticResource HasValueToVisibility}}"
                   Text="The online check waits 10 seconds between parts, as linux-hardware.org asks. To skip it, cancel and untick the online check." />
        <Button Content="_Cancel" Command="{Binding CancelScanCommand}" Margin="0,20,0,0" Padding="24,6" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
