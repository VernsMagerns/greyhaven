<UserControl x:Class="GreyHaven.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">
    <UserControl.Resources>

        <!-- One link (or plain text for sources without a URL). -->
        <DataTemplate x:Key="LinkTemplate">
            <Grid>
                <Button Content="{Binding Title, Converter={StaticResource NoAccessKey}}" Command="{Binding OpenCommand}" Style="{StaticResource LinkButton}"
                        Visibility="{Binding IsLink, Converter={StaticResource HasValueToVisibility}}"
                        AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="Opens in your web browser" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}"
                           Visibility="{Binding IsLink, Converter={StaticResource NoValueToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- A notice that needs attention (update available, ARM chip, scan problems). -->
        <DataTemplate x:Key="NoticeTemplate">
            <Border Style="{StaticResource InfoBox}" Background="{Binding Kind, Converter={StaticResource NoticeBrush}}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One compact line per part, inside the folded-away groups. -->
        <DataTemplate x:Key="PartRowTemplate">
            <Border BorderBrush="{DynamicResource GH.CardBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource GH.TextSecondary}" />
                    </TextBlock>
                    <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource RatingBadge}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A part that needs attention: one plain line, everything else behind "Show more". -->
        <DataTemplate x:Key="PartTemplate">
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading3}" Margin="0" />
                                <Border Style="{StaticResource Pill}" Visibility="{Binding ImportanceLabel, Converter={StaticResource HasValueToVisibility}}">
                                    <TextBlock Text="{Binding ImportanceLabel}" FontSize="12" Foreground="{DynamicResource GH.TextSecondary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource RatingBadge}" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,8,0,4" />

                    <Expander Header="Show more" Style="{StaticResource ShowMore}" IsExpanded="{Binding IsExpanded}"
                              AutomationProperties.Name="{Binding AccessibleName, StringFormat=Show more about {0}}">
                        <StackPanel Margin="0,8,0,4">
                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" />
                            <TextBlock Text="{Binding ApproximationNote}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                       Visibility="{Binding ApproximationNote, Converter={StaticResource HasValueToVisibility}}" />
                            <TextBlock Text="{Binding ConfidenceLabel}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />

                            <!-- How to fix it -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasFix, Converter={StaticResource HasValueToVisibility}}">
                                <TextBlock Text="{Binding FixTitle}" Style="{StaticResource Strong}" />
                                <ItemsControl ItemsSource="{Binding FixSteps}" AlternationCount="100" Margin="0,6,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Body}"
                                                           Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ItemNumber}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding FixCommands}" Margin="0,8,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CommandBox}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                             FontFamily="{StaticResource CodeFont}" Foreground="{DynamicResource GH.Text}"
                                                             VerticalAlignment="Center" TextWrapping="Wrap"
                                                             AutomationProperties.Name="{Binding AccessibleName}" />
                                                    <Button Grid.Column="1" Content="Copy" Command="{Binding CopyCommand}" Padding="12,4" Margin="8,0,0,0"
                                                            AutomationProperties.Name="{Binding Text, StringFormat=Copy command: {0}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding NeedsInternetText}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                           Visibility="{Binding NeedsInternetText, Converter={StaticResource HasValueToVisibility}}" />
                                <TextBlock Text="{Binding FixNote}" Style="{StaticResource Body}" Margin="0,6,0,0"
                                           Visibility="{Binding FixNote, Converter={StaticResource HasValueToVisibility}}" />
                                <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0"
                                        Visibility="{Binding SecureBootAdvice, Converter={StaticResource HasValueToVisibility}}">
                                    <TextBlock Text="{Binding SecureBootAdvice}" Style="{StaticResource Body}" />
                                </Border>
                            </StackPanel>

                            <!-- Live USB tests -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding LiveUsbTests, Converter={StaticResource HasValueToVisibility}}">
                                <TextBlock Text="Test this from a USB stick first" Style="{StaticResource Strong}" />
                                <ItemsControl ItemsSource="{Binding LiveUsbTests}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Sources -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding Sources, Converter={StaticResource HasValueToVisibility}}">
                                <TextBlock Text="Sources" Style="{StaticResource Strong}" />
                                <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource LinkTemplate}" Focusable="False" />
                            </StackPanel>

                            <!-- Technical details, one more click away -->
                            <Expander Header="Technical details" Style="{StaticResource ShowMore}" IsExpanded="{Binding ShowTechnicalDetails}" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding TechnicalDetails}" Margin="0,6,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" />
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                         Background="Transparent" Foreground="{DynamicResource GH.Text}" TextWrapping="Wrap"
                                                         FontFamily="{StaticResource CodeFont}" AutomationProperties.Name="{Binding Label}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="0,16,0,0">
        <!-- Demo mode: a slim strip, not a box -->
        <Border Style="{StaticResource InfoBox}" CornerRadius="14" Padding="10,2" HorizontalAlignment="Left" BorderThickness="1.5"
                Visibility="{Binding DemoText, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding DemoText}" Style="{StaticResource Body}" FontSize="14" />
        </Border>
        <ItemsControl ItemsSource="{Binding Notices}" ItemTemplate="{StaticResource NoticeTemplate}" Focusable="False" />

        <!-- Headline with the score beside it -->
        <ContentControl Style="{StaticResource Sticker}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Heading1}" Focusable="True" infra:Accessibility.FocusOnShow="True" />
                    <TextBlock Text="{Binding Suggestion}" Style="{StaticResource Lead}" FontSize="20"
                               Visibility="{Binding Suggestion, Converter={StaticResource HasValueToVisibility}}" />
                    <TextBlock Text="{Binding HeadlineSummary}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                    <!-- Apps the person needs that won't work on Linux. -->
                    <Border Style="{StaticResource WarningBox}" Margin="0,10,0,0" Visibility="{Binding MustHaveHeadline, Converter={StaticResource HasValueToVisibility}}">
                        <TextBlock Text="{Binding MustHaveHeadline}" Style="{StaticResource Body}" infra:Accessibility.Announce="True" />
                    </Border>
                    <!-- The main next action, where people look first (testers missed the card further down). -->
                    <Button Content="Show me how to switch →" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding DataContext.ShowWalkthroughCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <Grid Grid.Column="1" Width="128" Height="128" VerticalAlignment="Center" AutomationProperties.Name="{Binding ScoreAccessibleName}">
                    <Ellipse Fill="{DynamicResource GH.Shadow}" Margin="6,6,0,0" />
                    <Ellipse Fill="{DynamicResource GH.Accent}" Stroke="{DynamicResource GH.CardBorder}" StrokeThickness="2.5" Margin="0,0,6,6" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,6,6">
                        <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource HeadingFont}" FontSize="46" FontWeight="Bold"
                                   Foreground="{DynamicResource GH.OnAccent}" HorizontalAlignment="Center" />
                        <TextBlock Text="out of 100" FontSize="13" Foreground="{DynamicResource GH.OnAccent}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- Why switch now? (Windows 10 only) -->
        <Border Margin="0,10,0,4" Visibility="{Binding WhySwitchText, Converter={StaticResource HasValueToVisibility}}">
            <Expander Header="Why switch now?" Style="{StaticResource ShowMore}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding WhySwitchText}" Style="{StaticResource Body}" />
                    <Border Margin="0,6,0,0" Visibility="{Binding WhySwitchLink, Converter={StaticResource HasValueToVisibility}}">
                        <ContentPresenter Content="{Binding WhySwitchLink}" ContentTemplate="{StaticResource LinkTemplate}" />
                    </Border>
                </StackPanel>
            </Expander>
        </Border>

        <!-- Your version of Linux -->
        <StackPanel Visibility="{Binding HasRecommendation, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock x:Name="PathsHeading" Text="{Binding PathsHeading}" Style="{StaticResource Heading2}" />
            <TextBlock Text="{Binding PathsIntro}" Style="{StaticResource Secondary}" Margin="0,0,0,10"
                       Visibility="{Binding PathsIntro, Converter={StaticResource HasValueToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Paths}" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=PathsHeading}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <RadioButton GroupName="RecommendationPath" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Heading3}" Margin="0" />
                                            <Border Style="{StaticResource Pill}" Background="{DynamicResource GH.NoticeWarning}">
                                                <TextBlock Text="{Binding Tag}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GH.Text}" />
                                            </Border>
                                            <TextBlock Text="{Binding DefaultLabel}" Style="{StaticResource Secondary}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding DefaultLabel, Converter={StaticResource HasValueToVisibility}}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </RadioButton>
                                <Button Content="{Binding AboutLabel, Converter={StaticResource NoAccessKey}}" Style="{StaticResource LinkButton}" Margin="30,6,0,0" Click="About_Click"
                                        Visibility="{Binding About, Converter={StaticResource HasValueToVisibility}}" />
                                <Expander Header="Show more" Style="{StaticResource ShowMore}" Margin="30,6,0,0"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Show more about {0}}">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Paragraph}" Style="{StaticResource Body}" />
                                        <Border Style="{StaticResource WarningBox}" Margin="0,10,0,0"
                                                Visibility="{Binding SecureBootText, Converter={StaticResource HasValueToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="About Secure Boot" Style="{StaticResource Strong}" />
                                                <TextBlock Text="{Binding SecureBootText}" Style="{StaticResource Body}" Margin="0,4,0,6" />
                                                <Border Visibility="{Binding Guide, Converter={StaticResource HasValueToVisibility}}">
                                                    <ContentPresenter Content="{Binding Guide}" ContentTemplate="{StaticResource LinkTemplate}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0">
                                            <Run Text="You'll get:" FontWeight="SemiBold" />
                                            <Run Text="{Binding YoullGet, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Other versions of Linux exist. -->
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0">
                <Run Text="{Binding OtherVersionsText, Mode=OneWay}" />
            </TextBlock>
            <ContentPresenter Content="{Binding OtherVersionsLink}" ContentTemplate="{StaticResource LinkTemplate}" Margin="0,2,0,0" />

            <!-- What's next -->
            <ContentControl Style="{StaticResource Sticker}" Margin="0,16,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="What's next?" Style="{StaticResource Heading2}" Margin="0,0,0,4" />
                        <TextBlock Text="We'll guide you, one step at a time." Style="{StaticResource Body}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="What's _next →" Style="{StaticResource AccentButton}" VerticalAlignment="Center"
                            Command="{Binding DataContext.ShowWalkthroughCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </ContentControl>
        </StackPanel>

        <!-- Parts -->
        <TextBlock Text="{Binding PartsHeading}" Style="{StaticResource Heading2}" />
        <StackPanel Visibility="{Binding ComparingText, Converter={StaticResource HasValueToVisibility}}" Margin="0,0,0,10">
            <TextBlock Text="{Binding ComparingText}" Style="{StaticResource Body}" />
            <Button Content="Show my pick" Command="{Binding ShowChosenDistroCommand}" Style="{StaticResource LinkButton}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding AttentionParts}" ItemTemplate="{StaticResource PartTemplate}" Focusable="False" />
        <Expander Header="{Binding WorkingHeading}" Style="{StaticResource ShowMore}" Margin="0,4,0,12"
                  Visibility="{Binding WorkingHeading, Converter={StaticResource HasValueToVisibility}}">
            <ItemsControl ItemsSource="{Binding WorkingParts}" ItemTemplate="{StaticResource PartRowTemplate}" Margin="0,8,0,0" Focusable="False" />
        </Expander>
        <Expander Header="{Binding UncheckedHeading}" Style="{StaticResource ShowMore}" Margin="0,0,0,12"
                  Visibility="{Binding UncheckedHeading, Converter={StaticResource HasValueToVisibility}}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding UncheckedAdvice}" Style="{StaticResource Body}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding UncheckedParts}" ItemTemplate="{StaticResource PartRowTemplate}" Focusable="False" />
            </StackPanel>
        </Expander>
        <Expander Header="{Binding ChipsetHeading}" Style="{StaticResource ShowMore}" Margin="0,0,0,12"
                  Visibility="{Binding ChipsetHeading, Converter={StaticResource HasValueToVisibility}}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding ChipsetAbout}" Style="{StaticResource Body}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding ChipsetParts}" ItemTemplate="{StaticResource PartRowTemplate}" Focusable="False" />
            </StackPanel>
        </Expander>

        <!-- Your apps: a summary line, then the list by kind of app. Private: stays on this PC. -->
        <StackPanel Visibility="{Binding HasApps, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="Your apps" Style="{StaticResource Heading2}" />
            <TextBlock Text="{Binding AppsSummary}" Style="{StaticResource Body}" />
            <TextBlock Text="{Binding AppsPrivacy}" Style="{StaticResource Secondary}" FontSize="14" Margin="0,4,0,8" />
            <Expander Header="{Binding AppsHeading}" Style="{StaticResource ShowMore}" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding AppGroups}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Heading3}" Margin="0,12,0,4" />
                                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource GH.CardBorder}" BorderThickness="0,0,0,1" Padding="0,8" AutomationProperties.Name="{Binding AccessibleName}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <infra:DecorativeText Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"
                                                                                  Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
                                                            <TextBlock Text="{Binding Verdict}" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" />
                                                    <TextBlock Style="{StaticResource Secondary}" Visibility="{Binding GetText, Converter={StaticResource HasValueToVisibility}}">
                                                        <Run Text="{Binding GetText, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Command, Mode=OneWay}" FontFamily="{StaticResource CodeFont}" />
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Hardware}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding StringFormat=Uses your {0}}" Style="{StaticResource Secondary}" /></DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Alternatives}" Focusable="False" Margin="16,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,4">
                                                                    <TextBlock Style="{StaticResource Body}">
                                                                        <Run Text="Instead: " /><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Closeness, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Body}" />
                                                                    <TextBlock Style="{StaticResource Secondary}">
                                                                        <Run Text="{Binding GetText, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Command, Mode=OneWay}" FontFamily="{StaticResource CodeFont}" />
                                                                    </TextBlock>
                                                                    <ItemsControl ItemsSource="{Binding Hardware}" Focusable="False">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate><TextBlock Text="{Binding StringFormat=Uses your {0}}" Style="{StaticResource Secondary}" /></DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <CheckBox IsChecked="{Binding IsMustHave}" Margin="0,6,0,0" AutomationProperties.Name="{Binding MustHaveLabel}">
                                                        <TextBlock Text="I need this app" Style="{StaticResource Body}" FontSize="14" />
                                                    </CheckBox>
                                                    <Border Style="{StaticResource WarningBox}" Visibility="{Binding MustHaveWarning, Converter={StaticResource HasValueToVisibility}}">
                                                        <TextBlock Text="{Binding MustHaveWarning}" Style="{StaticResource Body}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>

        <!-- Check a game: any game, from the bundled ProtonDB dump and anti-cheat list (nothing sent anywhere). -->
        <StackPanel DataContext="{Binding Games}" Margin="0,0,0,12" AutomationProperties.Name="Check a game">
            <TextBlock Text="Check a game" Style="{StaticResource Heading2}" />
            <TextBlock Text="See whether a game runs on Linux before you switch. Type its name." Style="{StaticResource Body}" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}" MaxWidth="420" HorizontalAlignment="Left" Margin="0,8,0,4"
                     AutomationProperties.Name="Game name" AutomationProperties.HelpText="Results appear below as you type." />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Secondary}" infra:Accessibility.Announce="True"
                       Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource GH.CardBorder}" BorderThickness="0,0,0,1" Padding="0,8" AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <infra:DecorativeText Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"
                                                              Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
                                        <TextBlock Text="{Binding Verdict}" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" />
                                <Button Content="{Binding Link.Title, Converter={StaticResource NoAccessKey}}" Command="{Binding Link.OpenCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                        Visibility="{Binding Link, Converter={StaticResource HasValueToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Sources}" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Things to test before installing -->
        <Border Style="{StaticResource Card}" Padding="16,10" Visibility="{Binding CaveatsHeading, Converter={StaticResource HasValueToVisibility}}">
            <Expander Header="{Binding CaveatsHeading}" Style="{StaticResource ShowMore}">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="We can't check these from Windows. Test them by trying Linux from a USB stick first. The steps show you how."
                               Style="{StaticResource Body}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Caveats}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". " /><Run Text="{Binding WhatToTest, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </Border>

        <!-- Compare versions of Linux -->
        <TextBlock x:Name="CompareHeading" Text="Compare versions of Linux" Style="{StaticResource Heading2}" />
        <ItemsControl ItemsSource="{Binding Distros}" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=CompareHeading}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
                        <RadioButton GroupName="CompareDistro" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" />
                                <TextBlock Text="{Binding ScoreLine}" Style="{StaticResource Body}" />
                                <TextBlock Text="{Binding ChosenLabel}" Style="{StaticResource Secondary}" FontWeight="SemiBold"
                                           Visibility="{Binding ChosenLabel, Converter={StaticResource HasValueToVisibility}}" />
                            </StackPanel>
                        </RadioButton>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Save -->
        <TextBlock Text="Save your results" Style="{StaticResource Heading2}" />
        <TextBlock Text="Keep a copy to read on your phone or print. It includes every step." Style="{StaticResource Body}" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal">
            <Button Content="Save _report…" Padding="24,6" HorizontalAlignment="Left" Command="{Binding SaveReportCommand}" />
            <CheckBox Content="Include my apps" IsChecked="{Binding IncludeApps}" Margin="16,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding HasApps, Converter={StaticResource HasValueToVisibility}}" />
            <Button Content="Show in folder" Margin="14,0,0,0" Style="{StaticResource LinkButton}" Command="{Binding ShowSavedReportCommand}"
                    Visibility="{Binding SavedPath, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>
        <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Body}" Margin="0,8,0,0" infra:Accessibility.Announce="True"
                   Visibility="{Binding SaveStatus, Converter={StaticResource HasValueToVisibility}}" />

        <!-- Footnote -->
        <StackPanel Margin="0,32,0,0">
            <TextBlock Text="{Binding Footnote}" Style="{StaticResource Secondary}" FontSize="14" />
            <Button Content="_Scan again" Margin="0,12,0,0" Padding="24,6" HorizontalAlignment="Left"
                    Command="{Binding DataContext.StartOverCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
