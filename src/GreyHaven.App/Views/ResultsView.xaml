<UserControl x:Class="GreyHaven.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">
    <UserControl.Resources>

        <!-- A notice: title + message, tinted background, plus an optional link. -->
        <DataTemplate x:Key="NoticeTemplate">
            <Border Background="{Binding Kind, Converter={StaticResource NoticeBrush}}" BorderBrush="{DynamicResource GH.CardBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One link (or plain text for sources without a URL). -->
        <DataTemplate x:Key="LinkTemplate">
            <Grid>
                <Button Content="{Binding Title}" Command="{Binding OpenCommand}" Style="{StaticResource LinkButton}"
                        Visibility="{Binding IsLink, Converter={StaticResource HasValueToVisibility}}"
                        AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="Opens in your web browser" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}"
                           Visibility="{Binding IsLink, Converter={StaticResource NoValueToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- One component: summary in the header, everything else one click away. -->
        <DataTemplate x:Key="ComponentTemplate">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                <Expander IsExpanded="{Binding IsExpanded}" Padding="16,12" HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="{Binding AccessibleName}">
                    <Expander.Header>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" />
                                    <Border BorderBrush="{DynamicResource GH.CardBorder}" BorderThickness="1" CornerRadius="4"
                                            Padding="6,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding ImportanceLabel, Converter={StaticResource HasValueToVisibility}}">
                                        <TextBlock Text="{Binding ImportanceLabel}" FontSize="12" Foreground="{DynamicResource GH.TextSecondary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource RatingBadge}" VerticalAlignment="Center" />
                        </Grid>
                    </Expander.Header>

                    <StackPanel Margin="0,12,0,4">
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding ApproximationNote}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                   Visibility="{Binding ApproximationNote, Converter={StaticResource HasValueToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ConfidenceLabel}" Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding WeakDataLabel}" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="12,0,0,0"
                                       Visibility="{Binding WeakDataLabel, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>

                        <!-- What to do -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding HasFix, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock Text="{Binding FixTitle}" Style="{StaticResource Strong}" />
                            <ItemsControl ItemsSource="{Binding FixSteps}" AlternationCount="100" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Body}"
                                                       Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ItemNumber}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding FixCommands}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CommandBox}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                         FontFamily="{StaticResource CodeFont}" Foreground="{DynamicResource GH.Text}"
                                                         VerticalAlignment="Center" TextWrapping="Wrap"
                                                         AutomationProperties.Name="{Binding AccessibleName}" />
                                                <Button Grid.Column="1" Command="{Binding CopyCommand}" Padding="10,4" Margin="8,0,0,0"
                                                        AutomationProperties.Name="{Binding Text, StringFormat=Copy command: {0}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <infra:DecorativeText Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                                        <TextBlock Text="Copy" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding NeedsInternetText}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                       Visibility="{Binding NeedsInternetText, Converter={StaticResource HasValueToVisibility}}" />
                            <TextBlock Text="{Binding FixNote}" Style="{StaticResource Body}" Margin="0,6,0,0"
                                       Visibility="{Binding FixNote, Converter={StaticResource HasValueToVisibility}}" />
                            <Border Background="{DynamicResource GH.NoticeWarning}" BorderBrush="{DynamicResource GH.CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                                    Visibility="{Binding SecureBootAdvice, Converter={StaticResource HasValueToVisibility}}">
                                <TextBlock Text="{Binding SecureBootAdvice}" Style="{StaticResource Body}" />
                            </Border>
                        </StackPanel>

                        <!-- Live USB tests -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding LiveUsbTests, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock Text="Test this with a live USB" Style="{StaticResource Strong}" />
                            <ItemsControl ItemsSource="{Binding LiveUsbTests}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Sources -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Sources, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock Text="Sources" Style="{StaticResource Strong}" />
                            <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource LinkTemplate}" Focusable="False" />
                        </StackPanel>

                        <!-- Technical details, one more click away -->
                        <Expander Header="Technical details" IsExpanded="{Binding ShowTechnicalDetails}" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding TechnicalDetails}" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" />
                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent" Foreground="{DynamicResource GH.Text}" TextWrapping="Wrap"
                                                     FontFamily="{StaticResource CodeFont}" AutomationProperties.Name="{Binding Label}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="0,16,0,0">
        <ItemsControl ItemsSource="{Binding Notices}" ItemTemplate="{StaticResource NoticeTemplate}" Focusable="False" />

        <TextBlock Text="Your results" Style="{StaticResource Heading1}" Focusable="True" infra:Accessibility.FocusOnShow="True" />

        <!-- Summary score up top -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource GH.Text}" AutomationProperties.Name="{Binding ScoreAccessibleName}">
                        <Run Text="{Binding ScoreText, Mode=OneWay}" FontSize="56" FontWeight="SemiBold" />
                        <Run Text="/ 100" FontSize="20" Foreground="{DynamicResource GH.TextSecondary}" />
                    </TextBlock>
                    <TextBlock Text="{Binding BandText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource GH.Text}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DistroName}" Style="{StaticResource Strong}" FontSize="16" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ScoreNote}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                               Visibility="{Binding ScoreNote, Converter={StaticResource HasValueToVisibility}}" />
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding ComparingText, Converter={StaticResource HasValueToVisibility}}">
                        <TextBlock Text="{Binding ComparingText}" Style="{StaticResource Body}" />
                        <Button Content="Show my chosen distro" Command="{Binding ShowChosenDistroCommand}" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Recommendation -->
        <TextBlock Text="What GreyHaven recommends" Style="{StaticResource Heading2}" />
        <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource Body}" Margin="0,0,0,12" />

        <StackPanel Visibility="{Binding HasPathChoice, Converter={StaticResource HasValueToVisibility}}" Margin="0,0,0,8">
            <TextBlock x:Name="PathLabel" Text="Choose how you'd like to switch" Style="{StaticResource Strong}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Paths}" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=PathLabel}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="RecommendationPath" IsChecked="{Binding IsSelected}" Margin="0,0,0,8"
                                     AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Strong}">
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text="{Binding DefaultLabel, Mode=OneWay, StringFormat=({0})}" FontWeight="Normal" />
                                </TextBlock>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Details of the selected path -->
        <ItemsControl ItemsSource="{Binding Paths}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsSelected, Converter={StaticResource HasValueToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading3}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Paragraph}" Style="{StaticResource Body}" />
                            <Border Background="{DynamicResource GH.NoticeWarning}" BorderBrush="{DynamicResource GH.CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,12" Margin="0,12,0,0"
                                    Visibility="{Binding SecureBootNotice, Converter={StaticResource HasValueToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Secure Boot needs to be turned off" Style="{StaticResource Strong}" />
                                    <TextBlock Text="{Binding SecureBootNotice}" Style="{StaticResource Body}" Margin="0,4,0,8" />
                                    <ContentPresenter Content="{Binding Guide}" ContentTemplate="{StaticResource LinkTemplate}"
                                                      Visibility="{Binding Guide, Converter={StaticResource HasValueToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding DownloadText}" Style="{StaticResource Secondary}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Compare distros -->
        <TextBlock x:Name="CompareHeading" Text="Compare distros" Style="{StaticResource Heading2}" />
        <TextBlock Text="Select a distro to see how each part of your PC works on it." Style="{StaticResource Secondary}" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Distros}" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=CompareHeading}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="CompareDistro" IsChecked="{Binding IsSelected}" Margin="0,0,10,0"
                                 AutomationProperties.Name="{Binding AccessibleName}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" />
                            <TextBlock Text="{Binding ScoreLine}" Style="{StaticResource Body}" />
                            <TextBlock Text="{Binding ChosenLabel}" Style="{StaticResource Secondary}"
                                       Visibility="{Binding ChosenLabel, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Components -->
        <TextBlock Style="{StaticResource Heading2}">
            <Run Text="How each part works on" />
            <Run Text="{Binding DistroName, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding ImportanceKey, Mode=OneTime}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading3}" />
                        <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentTemplate}" Focusable="False" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Things to test from a live USB -->
        <StackPanel Visibility="{Binding Caveats, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="Test these with a live USB first" Style="{StaticResource Heading2}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10"
                       Text="These can't be checked from Windows. A live USB lets you try Linux without installing anything." />
            <ItemsControl ItemsSource="{Binding Caveats}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" />
                                <TextBlock Text="{Binding Why}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0">
                                    <Run Text="What to test:" FontWeight="SemiBold" />
                                    <Run Text="{Binding WhatToTest, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Margin="0,24,0,0">
            <TextBlock Text="{Binding DataBuiltText}" Style="{StaticResource Secondary}" />
            <Button Content="_Scan again" Margin="0,12,0,0" Padding="24,6" HorizontalAlignment="Left"
                    Command="{Binding DataContext.StartOverCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
