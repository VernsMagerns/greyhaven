<UserControl x:Class="GreyHaven.App.Views.WalkthroughView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">
    <UserControl.Resources>
        <!-- A tickable line (backup list, final checks). -->
        <DataTemplate x:Key="CheckItem">
            <Border BorderBrush="{DynamicResource GH.CardBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Text}" VerticalContentAlignment="Top">
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                </CheckBox>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="0,16,0,0">
        <Button Content="← Back to results" Command="{Binding BackToResultsCommand}" Style="{StaticResource LinkButton}" Margin="0,0,0,12" />

        <!-- The five parts: number and name, with where you are. -->
        <ItemsControl ItemsSource="{Binding Phases}" Focusable="False" Margin="0,0,0,16" AutomationProperties.Name="Your progress">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Box" Margin="0,0,6,0" Padding="8,6" BorderThickness="2" CornerRadius="8"
                            BorderBrush="{DynamicResource GH.CardBorder}" Background="{DynamicResource GH.Card}"
                            AutomationProperties.Name="{Binding AccessibleName}" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Stroke="{DynamicResource GH.CardBorder}" StrokeThickness="2" />
                                <infra:DecorativeText x:Name="Num" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="110" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="now">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GH.Accent}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource GH.Accent}" />
                            <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource GH.OnAccent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="done">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GH.NoticeInfo}" />
                            <Setter TargetName="Num" Property="Text" Value="✓" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="StepTitle" Text="{Binding Title}" Style="{StaticResource Heading1}" Focusable="True" infra:Accessibility.FocusOnShow="True" />
        <TextBlock Text="{Binding Announcement}" infra:Accessibility.Announce="True" Height="0" Margin="0" />
        <TextBlock Text="{Binding Lead}" Style="{StaticResource Lead}" Margin="0,0,0,12" />

        <!-- ===== How do you want to install? ===== -->
        <ItemsControl ItemsSource="{Binding Choices}" Focusable="False"
                      Visibility="{Binding Screen, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Choose}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <RadioButton GroupName="InstallChoice" IsChecked="{Binding IsSelected}" IsEnabled="{Binding Possible}"
                                     AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading3}" Margin="0" />
                                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Visibility="{Binding Recommended, Converter={StaticResource HasValueToVisibility}}">
                                        <TextBlock Text="Suggested" FontSize="13" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Checks}" Focusable="False" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <infra:DecorativeText Text="{Binding Glyph}" FontWeight="Bold" Foreground="{Binding ColourKey, Converter={StaticResource PaletteBrush}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" FontSize="14" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </RadioButton>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Back up: a checklist (required when replacing Windows) ===== -->
        <ItemsControl ItemsSource="{Binding Checklist}" ItemTemplate="{StaticResource CheckItem}" Focusable="False" Margin="0,0,0,12"
                      Visibility="{Binding Screen, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Checklist}" />

        <!-- ===== Get Windows ready / startup settings: tasks ===== -->
        <ItemsControl ItemsSource="{Binding Tasks}" Focusable="False"
                      Visibility="{Binding Tasks, Converter={StaticResource HasValueToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading3}" />
                            <TextBlock Text="{Binding Why}" Style="{StaticResource Body}" Margin="0,4,0,8" />
                            <TextBlock Text="✓ Already done on your PC." Style="{StaticResource Strong}" Foreground="{DynamicResource GH.Works}"
                                       Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=already}" />
                            <TextBlock Text="✓ Done." Style="{StaticResource Strong}" Foreground="{DynamicResource GH.Works}"
                                       Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=done}" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" infra:Accessibility.Announce="True"
                                       Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />
                            <Button Content="{Binding ButtonLabel}" Command="{Binding AskCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                    Visibility="{Binding ShowButton, Converter={StaticResource HasValueToVisibility}}" />
                            <!-- Asks first: what will change, then the permission prompt is explained. -->
                            <Border Style="{StaticResource WarningBox}" Visibility="{Binding ShowConfirm, Converter={StaticResource HasValueToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Confirm}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding WhyPermission}" Style="{StaticResource Secondary}" Margin="0,6,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Yes, do it" Command="{Binding DoItCommand}" Style="{StaticResource AccentButton}" />
                                        <Button Content="Cancel" Command="{Binding CancelConfirmCommand}" Margin="10,0,0,0" Padding="20,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Waiting for Windows…" Style="{StaticResource Secondary}" Visibility="{Binding IsWorking, Converter={StaticResource HasValueToVisibility}}" />
                            <StackPanel Visibility="{Binding CanUndo, Converter={StaticResource HasValueToVisibility}}" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Undo}" Style="{StaticResource Secondary}" />
                                <Button Content="Undo" Command="{Binding UndoCommand}" HorizontalAlignment="Left" Padding="20,6" Margin="0,6,0,0" />
                            </StackPanel>
                            <!-- Instructions (and "Or do it yourself"), unless it's already done. -->
                            <StackPanel infra:BlockView.Blocks="{Binding How}" Margin="0,8,0,0"
                                        Visibility="{Binding IsDone, Converter={StaticResource NoValueToVisibility}}" />
                            <CheckBox Content="I've done this" IsChecked="{Binding ManuallyDone}" Margin="0,8,0,0"
                                      Visibility="{Binding IsOneClick, Converter={StaticResource NoValueToVisibility}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The step's own words (the same blocks the saved report prints). -->
        <StackPanel infra:BlockView.Blocks="{Binding Body}" />

        <!-- ===== Make your USB stick ===== -->
        <Border Style="{StaticResource Card}" DataContext="{Binding Usb}" AutomationProperties.Name="Your USB stick"
                Visibility="{Binding Converter={StaticResource HasValueToVisibility}}">
            <StackPanel>
                <TextBlock Text="No USB stick is plugged in. Plug yours in now: it shows up here by itself." Style="{StaticResource Strong}" TextWrapping="Wrap" infra:Accessibility.Announce="True"
                           Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=waiting}" />
                <StackPanel Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=choose}">
                    <ItemsControl ItemsSource="{Binding Sticks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <RadioButton GroupName="Stick" Content="{Binding Name}" FontWeight="SemiBold" IsEnabled="{Binding Check.CanUse}"
                                                 IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}"
                                                 AutomationProperties.HelpText="{Binding Contents}" />
                                    <TextBlock Text="{Binding Contents}" Style="{StaticResource Secondary}" Margin="28,2,0,0" />
                                    <TextBlock Text="{Binding Problem}" Style="{StaticResource Body}" Foreground="{DynamicResource GH.Unsupported}" Margin="28,2,0,0"
                                               Visibility="{Binding Problem, Converter={StaticResource HasValueToVisibility}}" />
                                    <TextBlock Text="{Binding Warning}" Style="{StaticResource Body}" Foreground="{DynamicResource GH.Partial}" Margin="28,2,0,0"
                                               Visibility="{Binding Warning, Converter={StaticResource HasValueToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource DangerBox}" Visibility="{Binding EraseText, Converter={StaticResource HasValueToVisibility}}">
                        <CheckBox IsChecked="{Binding Confirmed}" AutomationProperties.Name="{Binding EraseText}">
                            <TextBlock Text="{Binding EraseText}" Style="{StaticResource Strong}" TextWrapping="Wrap" />
                        </CheckBox>
                    </Border>
                    <Button Content="Make my USB stick" Command="{Binding StartCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                            IsEnabled="{Binding CanStart}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsWorking, Converter={StaticResource HasValueToVisibility}}">
                    <TextBlock Text="{Binding Stage}" Style="{StaticResource Strong}" infra:Accessibility.Announce="True" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="14" Margin="0,8" AutomationProperties.Name="{Binding Stage}" />
                    <TextBlock Text="{Binding PermissionNote}" Style="{StaticResource Body}" Visibility="{Binding PermissionNote, Converter={StaticResource HasValueToVisibility}}" />
                    <TextBlock Text="{Binding Verification}" Style="{StaticResource Secondary}" Margin="0,6,0,8" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Padding="20,6" />
                </StackPanel>
                <TextBlock Text="✓ Your USB stick is ready." FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource GH.Works}"
                           Visibility="{Binding IsDone, Converter={StaticResource HasValueToVisibility}}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" infra:Accessibility.Announce="True" Margin="0,6,0,0"
                           Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />
                <Button Content="Try again" Command="{Binding TryAgainCommand}" HorizontalAlignment="Left" Padding="20,6" Margin="0,8,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="stopped"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="failed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== Take your guide: one big code, then keep clicking Next ===== -->
        <StackPanel DataContext="{Binding Guide}" Visibility="{Binding Converter={StaticResource HasValueToVisibility}}" Margin="0,8,0,0" HorizontalAlignment="Left">
            <Border Visibility="{Binding QrModules, Converter={StaticResource HasValueToVisibility}}" HorizontalAlignment="Left"
                    BorderBrush="{DynamicResource GH.CardBorder}" BorderThickness="2" CornerRadius="8" Background="White" Padding="6">
                <infra:QrCodeView Modules="{Binding QrModules}" Width="260" Height="260" AutomationProperties.Name="QR code that opens your guide on a phone" />
            </Border>
            <Button Content="Can't scan it? Open the guide to print it" Command="{Binding OpenGuideCommand}" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left" Margin="0,10,0,2" />
            <TextBlock Text="{Binding SavedText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                       Visibility="{Binding SavedText, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>

        <!-- ===== Restart into your USB stick ===== -->
        <StackPanel DataContext="{Binding Restart}" Visibility="{Binding Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="Before you restart" Style="{StaticResource Heading2}" />
            <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckItem}" Focusable="False" />
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" AutomationProperties.Name="{Binding Plan.FarewellTitle}">
                <StackPanel>
                    <TextBlock Text="{Binding Plan.FarewellTitle}" Style="{StaticResource Heading2}" Margin="0,0,0,6" />
                    <StackPanel infra:BlockView.Blocks="{Binding Plan.Farewell}" />
                </StackPanel>
            </Border>
            <Button Content="Restart into your USB stick" Command="{Binding RestartNowCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                    IsEnabled="{Binding CanRestart}" Margin="0,12,0,4" />
            <TextBlock Text="Tick each item first." Style="{StaticResource Secondary}" Visibility="{Binding CanRestart, Converter={StaticResource NoValueToVisibility}}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" infra:Accessibility.Announce="True" Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />
            <TextBlock Text="What you'll see" Style="{StaticResource Heading2}" />
            <StackPanel infra:BlockView.Blocks="{Binding Plan.AfterRestart}" />
            <Expander Header="USB stick not in the list?" Style="{StaticResource ShowMore}">
                <StackPanel infra:BlockView.Blocks="{Binding Plan.Fallback}" Margin="0,8,0,0" />
            </Expander>
            <Expander Header="If GreyHaven can't restart your PC" Style="{StaticResource ShowMore}">
                <StackPanel infra:BlockView.Blocks="{Binding Plan.Manual}" Margin="0,8,0,0" />
            </Expander>
        </StackPanel>

        <!-- ===== After you restart: a look at the guide ===== -->
        <StackPanel Visibility="{Binding Screen, Converter={StaticResource EqualsToVisibility}, ConverterParameter=AfterRestart}">
            <TextBlock Text="These steps are in your guide. GreyHaven can't help on screen once your PC restarts, so here's a look ahead." Style="{StaticResource Body}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Ahead}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource ShowMore}" Header="{Binding Title}" Margin="0,4">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Lead}" Style="{StaticResource Strong}" Margin="0,0,0,6" />
                                <StackPanel infra:BlockView.Blocks="{Binding Body}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- What could go wrong? (caution yellow) -->
        <Border Style="{StaticResource WarningBox}" Visibility="{Binding Tip, Converter={StaticResource HasValueToVisibility}}">
            <StackPanel>
                <TextBlock Text="What could go wrong?" Style="{StaticResource Strong}" />
                <TextBlock Text="{Binding Tip}" Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="0,24,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="← _Back" Command="{Binding BackCommand}" Padding="20,6" VerticalAlignment="Center"
                    Visibility="{Binding CanGoBack, Converter={StaticResource HasValueToVisibility}}" />
            <Button Grid.Column="1" Content="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource GoButton}"
                    IsEnabled="{Binding CanGoOn}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding NextLabel}"
                    AutomationProperties.HelpText="{Binding NextHint}" />
        </Grid>
        <TextBlock Text="{Binding NextHint}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,0,0,16"
                   Visibility="{Binding NextHint, Converter={StaticResource HasValueToVisibility}}" />
    </StackPanel>
</UserControl>
