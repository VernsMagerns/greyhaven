<UserControl x:Class="GreyHaven.App.Views.WalkthroughView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure">
    <StackPanel Margin="0,16,0,0">
        <Grid Margin="0,0,0,12">
            <Button Content="← Back to results" Command="{Binding BackToResultsCommand}" Style="{StaticResource LinkButton}" />
        </Grid>

        <TextBlock Text="{Binding StepCountText}" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
        <!-- Progress: one segment per step (done, now, still to come). Decorative; the step count says it in words. -->
        <infra:DecorativeItems ItemsSource="{Binding Progress}" Focusable="False" Margin="0,6,0,14">
            <infra:DecorativeItems.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </infra:DecorativeItems.ItemsPanel>
            <infra:DecorativeItems.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Seg" Height="10" CornerRadius="5" Margin="0,0,6,0" BorderThickness="2"
                            BorderBrush="{DynamicResource GH.CardBorder}" Background="{DynamicResource GH.Card}" />
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding}" Value="done">
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource GH.Works}" />
                            <Setter TargetName="Seg" Property="BorderBrush" Value="{DynamicResource GH.Works}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="now">
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource GH.Accent}" />
                            <Setter TargetName="Seg" Property="BorderBrush" Value="{DynamicResource GH.Accent}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </infra:DecorativeItems.ItemTemplate>
        </infra:DecorativeItems>

        <TextBlock x:Name="StepTitle" Text="{Binding Title}" Style="{StaticResource Heading1}" Focusable="True" infra:Accessibility.FocusOnShow="True" />
        <TextBlock Text="{Binding Announcement}" infra:Accessibility.Announce="True" Height="0" Margin="0" />

        <!-- The step's content: the same blocks the saved report prints. -->
        <StackPanel infra:BlockView.Blocks="{Binding Body}" />

        <!-- Install step only: keep Windows too, or replace it. -->
        <ItemsControl ItemsSource="{Binding InstallOptions}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <RadioButton GroupName="InstallOption" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding AccessibleName}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading3}" Margin="0" />
                                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                        <!-- Erasing: an unmissable warning, and the steps only after the tick. -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource DangerBox}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding NeedsConfirmation}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="This erases Windows and every file on this drive." Style="{StaticResource Strong}" FontSize="17" />
                                <TextBlock Text="Your photos, documents, games and programs will be gone. Only continue if your backup is done."
                                           Style="{StaticResource Body}" Margin="0,4,0,10" />
                                <CheckBox IsChecked="{Binding Confirmed}" AutomationProperties.Name="{Binding ConfirmText}">
                                    <TextBlock Text="{Binding ConfirmText}" Style="{StaticResource Body}" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <StackPanel infra:BlockView.Blocks="{Binding Steps}"
                                    Visibility="{Binding ShowSteps, Converter={StaticResource HasValueToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- What could go wrong? -->
        <Border Style="{StaticResource InfoBox}" Visibility="{Binding Tip, Converter={StaticResource HasValueToVisibility}}">
            <StackPanel>
                <TextBlock Text="What could go wrong?" Style="{StaticResource Strong}" />
                <TextBlock Text="{Binding Tip}" Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="0,24,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="← _Back" Command="{Binding BackCommand}" Padding="20,6" VerticalAlignment="Center"
                    Visibility="{Binding CanGoBack, Converter={StaticResource HasValueToVisibility}}" />
            <Button Grid.Column="1" Content="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Right" AutomationProperties.Name="{Binding NextLabel}" />
        </Grid>

        <Border Style="{StaticResource Card}" Padding="16,10">
            <Expander Header="All steps" Style="{StaticResource ShowMore}">
                <ItemsControl ItemsSource="{Binding StepTitles}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Command="{Binding GoCommand}" Style="{StaticResource LinkButton}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </Border>
    </StackPanel>
</UserControl>
