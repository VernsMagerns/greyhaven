<Application x:Class="GreyHaven.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] Fluent theme (light/dark/high contrast), swapped by ThemeManager -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
                <!-- [1] GreyHaven palette (GH.* brushes), filled by ThemeManager -->
                <ResourceDictionary />
                <!-- [2] GreyHaven styles -->
                <ResourceDictionary Source="Theming/Styles.xaml" />
                <!-- [3] Walkthrough pictures (generated by tools/illustrations/build.py) -->
                <ResourceDictionary Source="Theming/Illustrations.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
