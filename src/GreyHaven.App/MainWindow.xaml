<Window x:Class="GreyHaven.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:GreyHaven.App.Infrastructure"
        xmlns:views="clr-namespace:GreyHaven.App.Views"
        Title="{Binding WindowTitle}"
        Width="1000" Height="840" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource GH.Page}"
        Foreground="{DynamicResource GH.Text}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="15">
    <DockPanel>
        <!-- Top bar: app name and appearance setting -->
        <Grid DockPanel.Dock="Top" Margin="24,12,24,4">
            <TextBlock Text="GreyHaven" FontFamily="{StaticResource HeadingFont}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource GH.Text}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Sounds on/off. -->
                <Button Command="{Binding ToggleSoundsCommand}" Padding="10,6" MinWidth="40" MinHeight="36" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding SoundToggleName}" ToolTip="{Binding SoundToggleName}">
                    <infra:DecorativeText Text="{Binding SoundToggleGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18" />
                </Button>
                <!-- Light/dark: one icon button. High Contrast always follows Windows. -->
                <Button Command="{Binding ToggleThemeCommand}" Padding="10,6" MinWidth="40" MinHeight="36"
                        AutomationProperties.Name="{Binding ThemeToggleName}" ToolTip="{Binding ThemeToggleName}">
                    <infra:DecorativeText Text="{Binding ThemeToggleGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid MaxWidth="840" Margin="24,8,24,40">
                <views:StartView Visibility="{Binding Screen, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Start}" />
                <views:WorkingView Visibility="{Binding Screen, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Working}" />
                <views:ErrorView Visibility="{Binding Screen, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Error}" />
                <Border Visibility="{Binding Screen, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Results}">
                    <views:ResultsView DataContext="{Binding Results}" />
                </Border>
                <Border Visibility="{Binding Screen, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Walkthrough}">
                    <views:WalkthroughView DataContext="{Binding Walkthrough}" />
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
