<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\GreyHaven.Core\GreyHaven.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Brand fonts (SIL OFL 1.1, see assets/fonts), embedded into self-contained HTML reports. -->
    <EmbeddedResource Include="..\..\assets\fonts\Rubik-Bold.ttf;..\..\assets\fonts\Lexend-Regular.ttf;..\..\assets\fonts\Lexend-SemiBold.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Walkthrough pictures (generated by tools/illustrations/build.py). -->
    <EmbeddedResource Include="..\..\assets\illustrations\*.svg;..\..\assets\illustrations\catalog.json" LogicalName="Illustrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
</Project>
